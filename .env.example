# ─────────────────────────────────────────────
#  نوبت سلامت — متغیرهای محیطی
#  این فایل را به نام .env کپی کنید و مقادیر را پر کنید
# ─────────────────────────────────────────────

# اتصال دیتابیس PostgreSQL (الزامی)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/nobatesalamat

# رازهای امضای نشست — حتماً در پروداکشن مقدار تصادفی قوی بگذارید (الزامی)
# می‌توانید با دستور  openssl rand -base64 48  بسازید
ADMIN_SESSION_SECRET=
PATIENT_SESSION_SECRET=

# سرویس پیامک کاوه‌نگار (اختیاری — بدون آن، کد تایید در «حالت دمو» روی صفحه نمایش داده می‌شود)
# tmpplate باید در پنل کاوه‌نگار با متغیر %token ساخته شود
KAVENEGAR_API_KEY=
KAVENEGAR_TEMPLATE=nobatsalamat
